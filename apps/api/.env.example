# Copy to `apps/api/.env` for `npm run dev`. Compose sets these itself.

NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://habit_shaper:habit_shaper_local@127.0.0.1:3306/habit_shaper

# At least 32 characters.
JWT_SECRET=local-only-secret-change-before-production

COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:5173
