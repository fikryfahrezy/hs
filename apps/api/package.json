    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.3",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "mysql2": "3.24.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.3",
    "@types/cookie-parser": "1.4.10",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3"
  }
