{
  "name": "@habit-shaper/api",
  "version": "0.0.0",
  "private": true,
  "imports": {
    "#app/*": "./dist/*.js"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
